<Window x:Class="MasActivator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows 一键激活助手"
        Width="820" Height="810"
        MinWidth="820" MinHeight="810"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5EBF3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#9AAEC6" BlurRadius="14" ShadowDepth="2" Opacity="0.18" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2937" />
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#6B7280" />
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
        </Style>

        <Style x:Key="TypeRadio" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#FFFFFF" BorderBrush="#E5EBF3" BorderThickness="1"
                                CornerRadius="8" Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="Outer" Stroke="#9CA3AF" StrokeThickness="1.5" Fill="#FFFFFF" />
                                    <Ellipse x:Name="Inner" Width="8" Height="8" Fill="#2B6CB0" Visibility="Collapsed" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ContentPresenter RecognizesAccessKey="True"
                                                      TextElement.FontSize="13"
                                                      TextElement.FontWeight="SemiBold"
                                                      TextElement.Foreground="#111827" />
                                    <TextBlock Text="{TemplateBinding Tag}" FontSize="11.5" Foreground="#6B7280" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2B6CB0" />
                                <Setter TargetName="Bd" Property="Background" Value="#F0F7FF" />
                                <Setter TargetName="Outer" Property="Stroke" Value="#2B6CB0" />
                                <Setter TargetName="Inner" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#85B7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#245A94" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E4B7D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#A9BDD4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="86" />
            <RowDefinition Height="*" />
            <RowDefinition Height="46" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B5FA8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#33FFFFFF" Margin="0,0,14,0">
                        <Path Width="22" Height="22" Stretch="Uniform" Stroke="White" StrokeThickness="1.6" Fill="Transparent"
                              Data="M12 2 4 5.5V11c0 5 3.4 9.3 8 11 4.6-1.7 8-6 8-11V5.5L12 2Z M8.4 12l2.6 2.6 4.6-5.2" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Windows 一键激活助手" FontSize="19" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="简单 · 快速 · 小白也会用" FontSize="12" Foreground="#D6E7FA" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0"
                        Background="#33FFFFFF" CornerRadius="12" Padding="10,4">
                    <TextBlock Text="v1.0.0" FontSize="12" Foreground="White" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="18,18,18,2">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="3" Height="14" Background="#2B6CB0" CornerRadius="2" Margin="0,0,8,0" />
                            <TextBlock Text="01  激活教程" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="首次使用请先查看官方说明，了解各激活方式的适用范围。"
                                   Style="{StaticResource LabelText}" Margin="11,7,0,0" />
                        <TextBlock Margin="11,8,0,0" FontSize="12.5">
                            <Hyperlink NavigateUri="https://massgrave.dev/" RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="打开官方文档：https://massgrave.dev/" Foreground="#2B6CB0" TextDecorations="Underline" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="3" Height="14" Background="#2B6CB0" CornerRadius="2" Margin="0,0,8,0" />
                            <TextBlock Text="02  当前 Windows 版本信息" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <Grid Margin="11,10,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="系统版本" Style="{StaticResource LabelText}" />
                                <TextBlock x:Name="TxtOsName" Text="读取中…" Style="{StaticResource ValueText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                <TextBlock Text="显示版本" Style="{StaticResource LabelText}" />
                                <TextBlock x:Name="TxtDisplayVersion" Text="读取中…" Style="{StaticResource ValueText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="内部版本" Style="{StaticResource LabelText}" />
                                <TextBlock x:Name="TxtBuild" Text="读取中…" Style="{StaticResource ValueText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                <TextBlock Text="系统架构" Style="{StaticResource LabelText}" />
                                <TextBlock x:Name="TxtArch" Text="读取中…" Style="{StaticResource ValueText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="安装类型" Style="{StaticResource LabelText}" />
                                <TextBlock x:Name="TxtInstallType" Text="读取中…" Style="{StaticResource ValueText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="激活状态" Style="{StaticResource LabelText}" />
                                <TextBlock x:Name="TxtLicense" Text="读取中…" Style="{StaticResource ValueText}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <Border Width="3" Height="14" Background="#2B6CB0" CornerRadius="2" Margin="0,0,8,0" />
                            <TextBlock Text="03  选择激活类型" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <RadioButton x:Name="RbHwid" Style="{StaticResource TypeRadio}" IsChecked="True"
                                     Content="Windows 数字激活（HWID）"
                                     Tag="推荐 · 自动匹配版本，重建系统后仍可激活" />
                        <RadioButton x:Name="RbOhook" Style="{StaticResource TypeRadio}"
                                     Content="Office 激活（Ohook）"
                                     Tag="适用于 Office 2016—2024 / Microsoft 365" />
                        <RadioButton x:Name="RbDual" Style="{StaticResource TypeRadio}"
                                     Content="Windows + Office 双激活"
                                     Tag="一次完成系统与办公软件激活" />
                        <RadioButton x:Name="RbTsforge" Style="{StaticResource TypeRadio}"
                                     Content="TSforge 激活"
                                     Tag="Windows / ESU / Office 兼容性方案" />
                        <RadioButton x:Name="RbKms" Style="{StaticResource TypeRadio}"
                                     Content="KMS 激活（180 天）"
                                     Tag="适合临时或批量环境，需要联网" />
                    </StackPanel>
                </Border>

                <Button x:Name="BtnActivate" Content="一 键 激 活" Style="{StaticResource AccentButton}"
                        Height="50" Margin="0,2,0,0" Click="BtnActivate_Click" />
                <TextBlock Text="点击后如弹出授权窗口，请选择“是”；等待黑色窗口自动结束即可"
                           FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock x:Name="TxtStatus" Text="" FontSize="12.5" Foreground="#2B6CB0"
                           HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,2" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E3E9F1" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <TextBlock Text="v1.0.0 · 内置 MAS 3.14 · © 2026 源动力" FontSize="11.5" Foreground="#8A94A6"
                           VerticalAlignment="Center" HorizontalAlignment="Left" />
                <TextBlock Text="仅供个人学习与测试使用，请支持正版" FontSize="11.5" Foreground="#8A94A6"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
