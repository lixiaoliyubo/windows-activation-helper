<Window x:Class="MasActivator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows 激活 · 清理助手"
        Icon="pack://application:,,,/Resources/app_icon.ico"
        Width="840" Height="720"
        MinWidth="840" MinHeight="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5EBF3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#9AAEC6" BlurRadius="14" ShadowDepth="2" Opacity="0.18" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2937" />
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#6B7280" />
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
        </Style>

        <Style x:Key="TypeCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7E0EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite" Grid.Column="0" Margin="12,0,0,0"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      IsHitTestVisible="False" />
                                    <ToggleButton x:Name="DropDownToggle" Grid.Column="0" Grid.ColumnSpan="2"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                  Focusable="False" ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path x:Name="Arrow" Data="M0 0 L5 5 L10 0" Stroke="#6B7280"
                                                          StrokeThickness="1.2" Fill="Transparent"
                                                          HorizontalAlignment="Right" Margin="0,0,12,0"
                                                          VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="180" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" Background="#FFFFFF" BorderBrush="#D7E0EC"
                                        BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#9AAEC6" BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#85B7EB" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2B6CB0" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2B6CB0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TypeComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="4,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF2FB" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F7FF" />
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="#2B6CB0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DescriptionPanel" TargetType="Border">
            <Setter Property="Background" Value="#F0F7FF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="MinHeight" Value="62" />
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E6F0FA" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E24B4A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C53030" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderTextButton" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#E6F0FA" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterTextButton" TargetType="Button">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#2B6CB0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF2FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#245A94" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E4B7D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#A9BDD4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Background" Value="#C0392B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A93226" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#922B21" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#D9A7A1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabHeader" TargetType="TabItem">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#6B7688" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Margin="2,0"
                                BorderBrush="Transparent" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="HeaderHost" ContentSource="Header"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DAE7F8" />
                                <Setter Property="Foreground" Value="#2B6CB0" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C9DCF0" />
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                                          Opacity="0.26" Color="#1B5FA8" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#1B5FA8" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border HorizontalAlignment="Left" Margin="18,10,18,4" CornerRadius="12"
                                    Background="#E3ECF7" BorderBrush="#D0DEEF" BorderThickness="1" Padding="3">
                                <TabPanel x:Name="HeaderPanel" IsItemsHost="True" />
                            </Border>
                            <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#2B6CB0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderBrush="#BFD3EA" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF2FB" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2B6CB0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F4F8" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#DCE3EC" />
                                <Setter Property="Foreground" Value="#A8B2C1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallSolidButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#2B6CB0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#245A94" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E4B7D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#B9C9DB" />
                                <Setter Property="Foreground" Value="#F2F6FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarnSmallButton" TargetType="Button" BasedOn="{StaticResource SmallSolidButton}">
            <Setter Property="Background" Value="#C0392B" />
        </Style>

        <!-- 清理项复选框：圆角方块 + 勾选填充 -->
        <Style x:Key="ItemCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Border x:Name="Box" CornerRadius="4.5" Background="#FFFFFF"
                                        BorderBrush="#C5D3E4" BorderThickness="1" />
                                <Path x:Name="Tick" Data="M 0 3.4 L 2.4 5.8 L 6.4 0.7" Stroke="#FFFFFF"
                                      StrokeThickness="1.5" Stretch="None" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                              TextElement.Foreground="#1F2937" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#2B6CB0" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#2B6CB0" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#2B6CB0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Background" Value="#F1F4F8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细进度条 -->
        <Style x:Key="SlimProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="#E7EDF6" CornerRadius="2" />
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#2B6CB0" Offset="0" />
                                        <GradientStop Color="#4F97E8" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细滚动条 -->
        <Style x:Key="SlimScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#CBD5E1" CornerRadius="3" Margin="1,0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SlimScroll" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar Grid.Column="1" x:Name="PART_VerticalScrollBar" Width="7" Margin="4,0,0,0"
                                       Orientation="Vertical" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                                       Value="{TemplateBinding VerticalOffset}" ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource SlimScrollThumb}" />
                                            </Track.Thumb>
                                        </Track>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,12,16,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2937" />
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#2B6CB0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="6,2">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF2FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D6DFEB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3" />
        </Style>

        <Style x:Key="CleanMenuItem" TargetType="MenuItem">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF2FB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#A8B3C2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="0" Background="#F4F7FB" BorderThickness="0" CornerRadius="12">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="46" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B5FA8" CornerRadius="12,12,0,0"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Border Width="36" Height="36" CornerRadius="9" Background="#33FFFFFF" Margin="0,0,12,0">
                        <Path Width="20" Height="20" Stretch="Uniform" Stroke="White" StrokeThickness="1.2" Fill="Transparent"
                              Data="M12 2 4 5.5V11c0 5 3.4 9.3 8 11 4.6-1.7 8-6 8-11V5.5L12 2Z M8.4 12l2.6 2.6 4.6-5.2" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Windows 激活 · 清理助手" FontSize="18.5" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="简单 · 快速 · 小白也会用" FontSize="12" Foreground="#D6E7FA" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Button Content="问题反馈" Style="{StaticResource HeaderTextButton}" ToolTip="把遇到的问题反馈给我们"
                            VerticalAlignment="Center" Click="BtnFeedback_Click" Margin="0,0,2,0" />
                    <Button Content="关于我" Style="{StaticResource HeaderTextButton}"
                            VerticalAlignment="Center" Click="BtnAbout_Click" Margin="2,0,10,0" />
                    <Button x:Name="BtnMinimize" Style="{StaticResource WindowButton}" Margin="4,0,0,0" ToolTip="最小化"
                            Click="BtnMinimize_Click">
                        <Grid Width="14" Height="14">
                            <Rectangle Width="11" Height="1.4" Fill="#EAF2FB" RadiusX="0.7" RadiusY="0.7"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource CloseButton}" Margin="4,0,0,0" ToolTip="关闭"
                            Click="BtnClose_Click">
                        <Grid Width="14" Height="14">
                            <Path Stroke="#EAF2FB" StrokeThickness="1.5" Data="M2.4,2.4 L11.6,11.6 M11.6,2.4 L2.4,11.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <TabControl Style="{StaticResource CleanTabControl}" Padding="0" TabStripPlacement="Top">
                <TabItem Style="{StaticResource TabHeader}" AutomationProperties.Name="系统激活">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="系统激活" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Margin="18,14,18,8">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="3" Height="14" Background="#2B6CB0" CornerRadius="2" Margin="0,0,8,0" />
                                        <TextBlock Text="当前 Windows 版本信息" Style="{StaticResource SectionTitle}" />
                                    </StackPanel>
                                    <Grid Margin="11,12,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                            <TextBlock Text="系统版本" Style="{StaticResource LabelText}" />
                                            <TextBlock x:Name="TxtOsName" Text="读取中…" Style="{StaticResource ValueText}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                            <TextBlock Text="显示版本" Style="{StaticResource LabelText}" />
                                            <TextBlock x:Name="TxtDisplayVersion" Text="读取中…" Style="{StaticResource ValueText}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                            <TextBlock Text="内部版本" Style="{StaticResource LabelText}" />
                                            <TextBlock x:Name="TxtBuild" Text="读取中…" Style="{StaticResource ValueText}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                                            <TextBlock Text="系统架构" Style="{StaticResource LabelText}" />
                                            <TextBlock x:Name="TxtArch" Text="读取中…" Style="{StaticResource ValueText}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="安装类型" Style="{StaticResource LabelText}" />
                                            <TextBlock x:Name="TxtInstallType" Text="读取中…" Style="{StaticResource ValueText}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                            <TextBlock Text="激活状态" Style="{StaticResource LabelText}" />
                                            <TextBlock x:Name="TxtLicense" Text="读取中…" Style="{StaticResource ValueText}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="3" Height="14" Background="#2B6CB0" CornerRadius="2" Margin="0,0,8,0" />
                                        <TextBlock Text="激活方式" Style="{StaticResource SectionTitle}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource DescriptionPanel}" Margin="0,10,0,0">
                                        <TextBlock
                                            Text="自动匹配微软官方 GVLK 密钥，依次执行：安装密钥 → 设置 KMS 服务器 → 激活。需保持联网，到期可再次运行续期。"
                                            FontSize="11.5" Foreground="#6B7280" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Button x:Name="BtnActivate" Content="一 键 激 活" Style="{StaticResource AccentButton}"
                                    Height="50" Margin="0,2,0,0" Click="BtnActivate_Click" IsDefault="True" />
                            <Border Height="40" Margin="0,10,0,0" Background="#F0F7FF" CornerRadius="8" Padding="12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7" Fill="#2B6CB0" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="TxtStatus"
                                               Text="点击开始激活，全程自动完成，无需任何操作。"
                                               FontSize="12" Foreground="#2B6CB0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Style="{StaticResource TabHeader}" AutomationProperties.Name="垃圾清理">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="垃圾清理" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="18,14,16,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 顶部总览：已发现垃圾 / 当前扫描位置 / 进度 / 扫描按钮 -->
                        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E4EAF3" BorderThickness="1"
                                CornerRadius="12" Padding="16,2,16,2" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="112" Height="112" VerticalAlignment="Center" Margin="0,0,12,0" ClipToBounds="False">
                                    <Ellipse x:Name="ScanGlow" Width="112" Height="112" Opacity="0" Visibility="Collapsed"
                                             IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Border x:Name="HeroIconCircle" Width="72" Height="72" CornerRadius="36" Background="#E7F0FB"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="HeroIconGlyph" Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                               Foreground="#2B6CB0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="HeroPercent" Text="0%" FontSize="20" FontWeight="Bold"
                                               Foreground="#C53030" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                    <Ellipse x:Name="RingTrack" Width="86" Height="86" Stroke="#E1E9F4" StrokeThickness="5"
                                             VerticalAlignment="Center" HorizontalAlignment="Center"
                                             Visibility="Collapsed" IsHitTestVisible="False" />
                                    <Path x:Name="ScanRing" StrokeThickness="5" StrokeLineJoin="Round" Visibility="Collapsed" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtHeroPrefix" Text="已发现" FontSize="12.5" Foreground="#6B7280"
                                                   VerticalAlignment="Bottom" Margin="0,0,8,3" />
                                        <TextBlock x:Name="TxtHeroSize" Text="—" FontSize="25" FontWeight="Bold"
                                                   Foreground="#1B5FA8" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtHeroUnit" Text="GB" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#4B5563" VerticalAlignment="Bottom" Margin="4,0,0,3" />
                                        <TextBlock x:Name="TxtHeroUnitText" Text="可清理垃圾" FontSize="11.5" Foreground="#94A3B8"
                                                   VerticalAlignment="Bottom" Margin="8,0,0,4" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="已选中" FontSize="11.5" Foreground="#8A94A6" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtHeroSelected" Text="0 MB" FontSize="13" FontWeight="Bold"
                                                   Foreground="#C2740C" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        <Border Width="1" Height="11" Background="#E2E8F0" Margin="10,0,10,0"
                                                VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtHeroSelectedMeta" Text="0 项" FontSize="11.5"
                                                   Foreground="#8A94A6" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtHeroSub" Text="点击右侧「开始扫描」，先统计可释放空间"
                                               FontSize="11.5" Foreground="#8A94A6" Margin="0,6,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                    <ProgressBar x:Name="ScanProgress" Style="{StaticResource SlimProgress}"
                                                 Maximum="100" Value="0" Margin="0" Height="0" Visibility="Collapsed" />
                                </StackPanel>

                                <Button Grid.Column="2" x:Name="BtnScanClean" Content="开始扫描"
                                        Style="{StaticResource AccentButton}" Width="112" Height="38"
                                        VerticalAlignment="Center" Click="BtnScanClean_Click" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E4EAF3" BorderThickness="1"
                                CornerRadius="10" Padding="0,4,0,4">
                            <ScrollViewer x:Name="CleanScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          FocusVisualStyle="{x:Null}" Style="{StaticResource SlimScroll}">
                                <StackPanel x:Name="CleanGroupsPanel" Margin="0,0,4,0" />
                            </ScrollViewer>
                        </Border>

                        <!-- 底部操作栏 -->
                        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E4EAF3" BorderThickness="1"
                                CornerRadius="12" Padding="16,11" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCleanSummary" Text="已选中 0 项" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#1F2937" />
                                    <TextBlock x:Name="TxtCleanHint" Text="扫描后可查看每一项的实际占用"
                                               FontSize="11" Foreground="#8A94A6" Margin="0,3,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnResetDefault" Content="恢复默认勾选" Style="{StaticResource LinkButton}"
                                            Click="BtnResetDefault_Click" Margin="0,0,10,0" FontSize="12" />
                                    <Button x:Name="BtnSelectAll" Content="全选" Style="{StaticResource LinkButton}"
                                            Click="BtnSelectAll_Click" Margin="0,0,2,0" FontSize="12" />
                                    <Button x:Name="BtnSelectNone" Content="全不选" Style="{StaticResource LinkButton}"
                                            Click="BtnSelectNone_Click" Margin="0,0,14,0" FontSize="12" />
                                    <Button x:Name="BtnClean" Content="开始清理" Style="{StaticResource AccentButton}"
                                            Width="112" Height="38" Click="BtnClean_Click" IsEnabled="False" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E3E9F1" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
            <Grid Margin="22,0">
                <TextBlock x:Name="TxtVersionFooter" Text="Windows 激活 · 清理助手 · v1.0.0 · © 2026 源动力" FontSize="11.5" Foreground="#8A94A6"
                           VerticalAlignment="Center" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="仅供个人学习与测试使用，请支持正版" FontSize="11.5" Foreground="#8A94A6"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button x:Name="BtnCheckUpdate" Content="检查更新" Style="{StaticResource FooterTextButton}"
                            VerticalAlignment="Center" Click="BtnCheckUpdate_Click" />
                    <Border Background="#EEF5FD" CornerRadius="10" Padding="8,3" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock x:Name="TxtVersionBadge" Text="v1.0.0" FontSize="11.5" Foreground="#2B6CB0" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 应用内确认弹层：分层窗口下系统 MessageBox 不可见，改用自绘遮罩 -->
        <Border x:Name="ConfirmOverlay" Grid.RowSpan="3" Background="#66101828" Visibility="Collapsed">
            <Border Width="420" Background="#FFFFFF" CornerRadius="12" Padding="22,18"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#20303F" BlurRadius="26" ShadowDepth="6" Opacity="0.35" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TxtConfirmTitle" Text="确认清理" FontSize="15" FontWeight="Bold"
                               Foreground="#1F2937" />
                    <TextBlock x:Name="TxtConfirmBody" Text="" FontSize="12" Foreground="#5A6B7F"
                               TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button x:Name="BtnConfirmCancel" Content="取消" Style="{StaticResource OutlineButton}"
                                Width="86" Click="BtnConfirmCancel_Click" Margin="0,0,10,0" />
                        <Button x:Name="BtnConfirmOk" Content="确定清理" Style="{StaticResource SmallSolidButton}"
                                Width="104" Click="BtnConfirmOk_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border x:Name="FeedbackOverlay" Grid.RowSpan="3" Background="#66101828" Visibility="Collapsed">
            <Border Width="470" Background="#FFFFFF" CornerRadius="12" Padding="22,18"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#20303F" BlurRadius="26" ShadowDepth="6" Opacity="0.35" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="问题反馈" FontSize="15" FontWeight="Bold" Foreground="#1F2937" />
                    <TextBlock x:Name="TxtFeedbackMeta" Text="" FontSize="11" Foreground="#94A3B8"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBox x:Name="TxtFeedbackInput" Height="118" Margin="0,10,0,0" FontSize="12"
                             AcceptsReturn="True" TextWrapping="Wrap" Padding="9,7" BorderThickness="1"
                             BorderBrush="#D6DFEB" Background="#F8FAFD" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" />
                    <TextBlock Text="点「复制并前往反馈页」后内容会复制到剪贴板，浏览器打开官网反馈页，粘贴提交即可。"
                               FontSize="11" Foreground="#94A3B8" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <Grid Margin="0,16,0,0">
                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#94A3B8">
                            <Hyperlink NavigateUri="https://yuandl.cn/feedback" RequestNavigate="Hyperlink_RequestNavigate"
                                       Foreground="#2B6CB0" TextDecorations="Underline"><Run Text="官网反馈页 yuandl.cn/feedback" /></Hyperlink>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Style="{StaticResource OutlineButton}" Width="80"
                                    Click="BtnFeedbackCancel_Click" Margin="0,0,10,0" />
                            <Button Content="复制并前往反馈页" Style="{StaticResource SmallSolidButton}" Width="146"
                                    Click="BtnFeedbackSubmit_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
        </Grid>
    </Border>
</Window>
