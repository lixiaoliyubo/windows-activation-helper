<Window x:Class="MasActivator.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本"
        Icon="pack://application:,,,/Resources/app_icon.ico"
        Width="520" Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">

    <Window.Resources>
        <Style x:Key="DialogCloseButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E6F0FA" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E24B4A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="18,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#245A94" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#A9BDD4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D7E0EC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="18,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F6FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10" Background="#F4F7FB" BorderBrush="#D6DFEB" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#5B6B80" BlurRadius="18" ShadowDepth="3" Opacity="0.28" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1B5FA8" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <TextBlock Text="发现新版本" FontSize="16" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center" />
                    <Button Content="×" Style="{StaticResource DialogCloseButton}" HorizontalAlignment="Right"
                            Click="BtnClose_Click" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,16,20,0">
                <Border Background="#FFFFFF" BorderBrush="#E5EBF3" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="当前版本" FontSize="11.5" Foreground="#6B7280" />
                            <TextBlock x:Name="TxtCurrentVersion" Text="v1.0.0" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#6B7280" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="→" FontSize="18" Foreground="#9CA3AF"
                                   VerticalAlignment="Center" Margin="18,10,18,0" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="最新版本" FontSize="11.5" Foreground="#6B7280" />
                            <TextBlock x:Name="TxtNewVersion" Text="v1.0.1" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#2B6CB0" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="本次更新内容" FontSize="13" FontWeight="SemiBold" Foreground="#1F2937"
                           Margin="2,16,0,8" />
                <Border Background="#FFFFFF" BorderBrush="#E5EBF3" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="160">
                        <TextBlock x:Name="TxtReleaseNotes" Text="" FontSize="12.5" Foreground="#4B5563"
                                   TextWrapping="Wrap" LineHeight="20" />
                    </ScrollViewer>
                </Border>
                <TextBlock x:Name="TxtSource" Text="" FontSize="11" Foreground="#9CA3AF" Margin="2,8,0,0" />
            </StackPanel>

            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E3E9F1" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button x:Name="BtnIgnore" Content="忽略此版本" Style="{StaticResource SecondaryButton}"
                            Click="BtnIgnore_Click" />
                    <Button x:Name="BtnUpdate" Content="立即更新" Style="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0" Click="BtnUpdate_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
