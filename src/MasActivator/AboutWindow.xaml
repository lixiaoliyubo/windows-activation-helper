<Window x:Class="MasActivator.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于我"
        Icon="pack://application:,,,/Resources/app_icon.ico"
        Width="500" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">

    <Window.Resources>
        <Style x:Key="AboutCloseButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E6F0FA" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E24B4A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AboutLink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#2B6CB0" />
        </Style>

    </Window.Resources>

    <Border Margin="10" Background="#F4F7FB" BorderBrush="#D6DFEB" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#5B6B80" BlurRadius="18" ShadowDepth="3" Opacity="0.28" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1B5FA8" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <TextBlock Text="关于本工具" FontSize="16" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center" />
                    <Button Content="×" Style="{StaticResource AboutCloseButton}" HorizontalAlignment="Right"
                            Click="BtnClose_Click" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,14,20,0">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="58" Height="58" CornerRadius="14" Background="#FFFFFF"
                            BorderBrush="#E5EBF3" BorderThickness="1">
                        <Image x:Name="ImgBrandLogo" Width="54" Height="54" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="阿波技术栈" FontSize="17" FontWeight="SemiBold" Foreground="#1F2937"
                               HorizontalAlignment="Center" Margin="0,9,0,0" />
                    <TextBlock Text="Windows 激活 · 清理助手" FontSize="12.5" FontWeight="SemiBold" Foreground="#1B5FA8"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <TextBlock Text="全栈 + 工业软件工程实践" FontSize="11.5" Foreground="#6B7280"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <Border Background="#FFFFFF" BorderBrush="#E5EBF3" BorderThickness="1" CornerRadius="10"
                        Padding="14,11" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="公众号" FontSize="12.5" Foreground="#6B7280" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="阿波技术栈" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#111827" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="官网" FontSize="12.5" Foreground="#6B7280" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" FontSize="13" VerticalAlignment="Center">
                                <Hyperlink NavigateUri="https://yuandl.cn" RequestNavigate="Hyperlink_RequestNavigate"
                                           Style="{StaticResource AboutLink}">
                                    <Run Text="https://yuandl.cn" TextDecorations="Underline" />
                                </Hyperlink>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Gitee" FontSize="12.5" Foreground="#6B7280" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" FontSize="12.5" VerticalAlignment="Center">
                                <Hyperlink NavigateUri="https://gitee.com/lixiaoliyubo/windows-activation-helper"
                                           RequestNavigate="Hyperlink_RequestNavigate" Style="{StaticResource AboutLink}">
                                    <Run Text="gitee.com/lixiaoliyubo/windows-activation-helper" TextDecorations="Underline" />
                                </Hyperlink>
                            </TextBlock>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GitHub" FontSize="12.5" Foreground="#6B7280" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock Grid.Column="1" FontSize="12.5" VerticalAlignment="Center">
                                <Hyperlink NavigateUri="https://github.com/lixiaoliyubo/windows-activation-helper"
                                           RequestNavigate="Hyperlink_RequestNavigate" Style="{StaticResource AboutLink}">
                                    <Run Text="github.com/lixiaoliyubo/windows-activation-helper" TextDecorations="Underline" />
                                </Hyperlink>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" BorderBrush="#E5EBF3" BorderThickness="1" CornerRadius="10"
                        Padding="10" Margin="0,12,0,0">
                    <Image x:Name="ImgPromo" Stretch="Uniform" HorizontalAlignment="Center"
                           ToolTip="微信扫码关注公众号「阿波技术栈」" />
                </Border>

                <Border Background="#F0F7FF" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="如果这款工具帮到了你，欢迎关注公众号、给项目点个 Star" 
                                   FontSize="12.5" Foreground="#1F2937" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock FontSize="11.5">
                                <Hyperlink NavigateUri="https://yuandl.cn" RequestNavigate="Hyperlink_RequestNavigate"
                                           Style="{StaticResource AboutLink}">
                                    <Run Text="访问官网" TextDecorations="Underline" />
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text=" · " FontSize="11.5" Foreground="#9CA3AF" Margin="6,0" />
                            <TextBlock FontSize="11.5">
                                <Hyperlink NavigateUri="https://github.com/lixiaoliyubo/windows-activation-helper"
                                           RequestNavigate="Hyperlink_RequestNavigate" Style="{StaticResource AboutLink}">
                                    <Run Text="GitHub Star" TextDecorations="Underline" />
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text=" · " FontSize="11.5" Foreground="#9CA3AF" Margin="6,0" />
                            <TextBlock FontSize="11.5">
                                <Hyperlink NavigateUri="https://gitee.com/lixiaoliyubo/windows-activation-helper"
                                           RequestNavigate="Hyperlink_RequestNavigate" Style="{StaticResource AboutLink}">
                                    <Run Text="Gitee Star" TextDecorations="Underline" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E3E9F1" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                <TextBlock x:Name="TxtAboutVersion" Text="v1.0.1 · © 2026 源动力" FontSize="11.5"
                           Foreground="#8A94A6" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</Window>
